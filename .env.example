# Copy to .env — NEVER commit .env, and NEVER put real secrets here.
# These are local-dev placeholders only.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://hrpayroll:hrpayroll_dev_only@localhost:5432/hrpayroll
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-secret-before-any-real-use
JWT_EXPIRES_IN=8h
# Superadmin Lite: MFA is mandatory in production. In local dev the flag below
# only records whether MFA was verified for the session; it is NOT a real MFA provider.
SUPERADMIN_MFA_REQUIRED=true
BREAK_GLASS_ENABLED=false
# VITE_API_URL — optional. Leave unset/empty for same-origin (the API serves
# the frontend on one deploy). Only set a full https URL if the API lives on
# a different domain. A localhost value is ignored in production.
VITE_API_URL=
